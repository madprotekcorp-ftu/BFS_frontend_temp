# Base URL of the Django API. Leave empty to use same-origin /api (dev proxy or same domain in prod).
VITE_API_BASE_URL=

# Development only: where the Vite dev server proxies /api (default http://127.0.0.1:8000).
# Point it at the backend developer's machine when testing against their server.
VITE_DEV_API_PROXY=

# Development only: serve an in-browser mock of the backend API so the admin can be
# explored before the Django backend is ready. Ignored in production builds.
VITE_USE_MOCK_API=true

# Development only, with the mock on: endpoints sent to the real backend (via the /api proxy)
# while all others stay mocked. Comma-separated "METHOD /path/"; a trailing * matches a prefix.
# Add each endpoint here as it is integrated, then remove the mock once all are live.
VITE_LIVE_ENDPOINTS=

# Public site URL, used for canonical links and Open Graph tags.
VITE_SITE_URL=https://www.example.com

# Business contact details. Leave empty until BFS confirms them; empty values are hidden.
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
VITE_BUSINESS_HOURS=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
